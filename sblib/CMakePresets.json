{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "default-build-directory",
            "description": "Sets the build directory",
            "hidden": true,
            "binaryDir": "${sourceDir}/cmake-build/${presetName}"
        },
        {
            "name": "default-generator-ninja-multi-config",
            "description": "Sets the Ninja Multi Config generator",
            "hidden": true,
            "generator": "Ninja Multi-Config"
        },
        {
            "name": "default-toolchain-arm-none-eabi",
            "description": "Sets Toolchain arm-none-eabi (using MCUXpresso)",
            "hidden": true,
            "toolchainFile": "${sourceDir}/../cmake/toolchains/arm-none-eabi_mcuxpresso.cmake"
        },
        {
            "name": "arm",
            "displayName": "ARM Target",
            "description": "Sets Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja Multi Config generator",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config",
                "default-toolchain-arm-none-eabi"
            ]
        },
        {
            "name": "arm_logging",
            "displayName": "ARM logging Target",
            "description": "Most of logging enabled",
            "hidden": false,
            "inherits": [
                "arm"
            ],
            "cacheVariables": {
                "SBLIB_DEBUG_BUS": "ON",
                "SBLIB_DEBUG_BUS_BITLEVEL": "ON",
                "SBLIB_INCLUDE_SERIAL": "ON",
                "SBLIB_SERIAL_SPEED": "115200",
                "SBLIB_DUMP_TELEGRAMS": "ON",
                "SBLIB_PIO_FOR_TEL_END_IND": "PIO1_4",
                "SBLIB_DUMP_COM_OBJ": "ON",
                "SBLIB_DUMP_MEM_OPS": "ON",
                "SBLIB_DUMP_PROPERTIES": "ON",
                "SBLIB_DUMP_TL4": "ON",
                "SBLIB_ROUTER": "OFF",
                "SBLIB_BUSMONITOR": "OFF",
                "SBLIB_SERIAL_RX_PIN": "PIO1_6",
                "SBLIB_SERIAL_TX_PIN": "PIO1_7",
                "SBLIB_LOGGING": "OFF",
                "SBLIB_LOGGING_DIR": "${sourceDir}/../logging"
            }
        },
        {
            "name": "x86",
            "displayName": "x86 Target",
            "description": "Sets architecture x86, build directory and Ninja Multi Config generator",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config"
            ],
            "cacheVariables": {
                "SBLIB_ARCHITECTURE": "x86"
            }
        },
        {
            "name": "x64",
            "displayName": "x64 Target",
            "description": "Sets architecture x64, build directory and Ninja Multi Config generator",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config"
            ],
            "cacheVariables": {
                "SBLIB_ARCHITECTURE": "x64"
            }
        },
        {
            "name": "x86_logging",
            "displayName": "x86 logging Target",
            "description": "Most of logging enabled",
            "hidden": false,
            "inherits": [
                "x86"
            ],
            "cacheVariables": {
                "SBLIB_DEBUG_BUS": "ON",
                "SBLIB_DEBUG_BUS_BITLEVEL": "ON",
                "SBLIB_INCLUDE_SERIAL": "ON",
                "SBLIB_SERIAL_SPEED": "115200",
                "SBLIB_DUMP_TELEGRAMS": "ON",
                "SBLIB_PIO_FOR_TEL_END_IND": "PIO1_4",
                "SBLIB_DUMP_COM_OBJ": "ON",
                "SBLIB_DUMP_MEM_OPS": "ON",
                "SBLIB_DUMP_PROPERTIES": "ON",
                "SBLIB_DUMP_TL4": "ON",
                "SBLIB_ROUTER": "OFF",
                "SBLIB_BUSMONITOR": "OFF",
                "SBLIB_SERIAL_RX_PIN": "PIO1_6",
                "SBLIB_SERIAL_TX_PIN": "PIO1_7",
                "SBLIB_LOGGING": "OFF",
                "SBLIB_LOGGING_DIR": "${sourceDir}/../logging"
            }
        },
        {
            "name": "default-toolchain-arm-none-eabi-generic",
            "description": "Sets the generic arm-none-eabi toolchain (no MCUXpresso installation required). Toolchain from ARM_TOOLCHAIN_PATH, MCUXPRESSO_TOOLCHAIN_PATH or PATH",
            "hidden": true,
            "toolchainFile": "${sourceDir}/../cmake/toolchains/arm-none-eabi.cmake"
        },
        {
            "name": "arm-generic",
            "displayName": "ARM Target (generic toolchain)",
            "description": "LPC1115 with the generic arm-none-eabi toolchain, build directory and Ninja Multi Config generator",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config",
                "default-toolchain-arm-none-eabi-generic"
            ],
            "cacheVariables": {
                "SBLIB_MCU": "LPC1115"
            }
        },
        {
            "name": "rp2350-pico2",
            "displayName": "RP2350 Target (Pico 2 test board)",
            "description": "RP2350 with the external Pico SDK 2.2.0 from PICO_SDK_PATH. Toolchain from ARM_TOOLCHAIN_PATH or MCUXPRESSO_TOOLCHAIN_PATH, picotool from PICOTOOL_DIR",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config"
            ],
            "cacheVariables": {
                "PICO_SDK_PATH": "$env{PICO_SDK_PATH}",
                "SBLIB_MCU": "RP2350",
                "PICO_PLATFORM": "rp2350-arm-s",
                "PICO_BOARD": "pico2",
                "SBLIB_BOARD": "pico2_testboard"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-arm",
            "configurePreset": "arm",
            "configuration": "Debug",
            "displayName": "ARM Target Debug Build",
            "description": "Build ARM target in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_arm"
            ]
        },
        {
            "name": "release-arm",
            "configurePreset": "arm",
            "configuration": "Release",
            "displayName": "ARM Target Release Build",
            "description": "Build ARM target in Release configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_arm"
            ]
        },
        {
            "name": "debug-arm-logging",
            "configurePreset": "arm_logging",
            "configuration": "Debug",
            "displayName": "ARM Target Debug Build",
            "description": "Build ARM target with logging in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_arm"
            ]
        },
        {
            "name": "debug-x86",
            "configurePreset": "x86",
            "configuration": "Debug",
            "displayName": "x86 Target Debug Build",
            "description": "Build x86 target in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x86"
            ]
        },
        {
            "name": "release-x86",
            "configurePreset": "x86",
            "configuration": "Release",
            "displayName": "x86 Target Release Build",
            "description": "Build x86 target in Release configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x86"
            ]
        },
        {
            "name": "debug-x64",
            "configurePreset": "x64",
            "configuration": "Debug",
            "displayName": "x64 Target Debug Build",
            "description": "Build x64 target in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x64"
            ]
        },
        {
            "name": "release-x64",
            "configurePreset": "x64",
            "configuration": "Release",
            "displayName": "x64 Target Release Build",
            "description": "Build x64 target in Release configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x64"
            ]
        },
        {
            "name": "debug-x86-logging",
            "configurePreset": "x86_logging",
            "configuration": "Debug",
            "displayName": "x86 Target Debug Build",
            "description": "Build x86 target with logging in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x86"
            ]
        },
        {
            "name": "debug-arm-generic",
            "configurePreset": "arm-generic",
            "configuration": "Debug",
            "displayName": "ARM Target Debug Build (generic toolchain)",
            "description": "Build ARM target in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_arm"
            ]
        },
        {
            "name": "release-arm-generic",
            "configurePreset": "arm-generic",
            "configuration": "Release",
            "displayName": "ARM Target Release Build (generic toolchain)",
            "description": "Build ARM target in Release configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_arm"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "build-arm-all",
            "description": "Build ARM target in Debug and Release configurations",
            "displayName": "Build ARM (all configs)",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm"
                },
                {
                    "type": "build",
                    "name": "release-arm"
                },
                {
                    "type": "build",
                    "name": "debug-arm"
                }
            ]
        },
        {
            "name": "build-x64-all",
            "description": "Build x64 target in Debug and Release configurations",
            "displayName": "Build x64 (all configs)",
            "steps": [
                {
                    "type": "configure",
                    "name": "x64"
                },
                {
                    "type": "build",
                    "name": "release-x64"
                },
                {
                    "type": "build",
                    "name": "debug-x64"
                }
            ]
        },
        {
            "name": "build-x86-all",
            "description": "Build x86 target in Debug and Release configurations",
            "displayName": "Build x86 (all configs)",
            "steps": [
                {
                    "type": "configure",
                    "name": "x86"
                },
                {
                    "type": "build",
                    "name": "release-x86"
                },
                {
                    "type": "build",
                    "name": "debug-x86"
                }
            ]
        },
        {
            "name": "build-x86-logging",
            "description": "Build x86 logging target in Debug configuration",
            "displayName": "Build x86 (logging config)",
            "steps": [
                {
                    "type": "configure",
                    "name": "x86_logging"
                },
                {
                    "type": "build",
                    "name": "debug-x86-logging"
                }
            ]
        },
        {
            "name": "build-arm-logging",
            "description": "Build ARM logging target in Debug configuration",
            "displayName": "Build ARM (logging config)",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm_logging"
                },
                {
                    "type": "build",
                    "name": "debug-arm-logging"
                }
            ]
        },
        {
            "name": "build-arm-generic-all",
            "description": "Build ARM target with the generic toolchain in Debug and Release configurations",
            "displayName": "Build ARM generic toolchain (all configs)",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm-generic"
                },
                {
                    "type": "build",
                    "name": "release-arm-generic"
                },
                {
                    "type": "build",
                    "name": "debug-arm-generic"
                }
            ]
        },
        {
            "name": "configure-rp2350-pico2",
            "description": "Configure sblib for RP2350 (Pico SDK setup check, no library target yet)",
            "displayName": "Configure RP2350 Pico 2",
            "steps": [
                {
                    "type": "configure",
                    "name": "rp2350-pico2"
                }
            ]
        }
    ]
}
